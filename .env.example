# Django
SECRET_KEY=change-me-to-a-long-random-string-at-least-50-chars-no-hash-symbols
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (MySQL / MariaDB — XAMPP defaults shown)
DB_ENGINE=django.db.backends.mysql
DB_NAME=news_platform
DB_USER=root
DB_PASSWORD=1111
DB_HOST=localhost
DB_PORT=3306

# Email (development: prints to console — no real SMTP needed)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# API throttling
API_THROTTLE_ANON=100/hour
API_THROTTLE_USER=1000/hour

# Upload limits (bytes)
MAX_IMAGE_UPLOAD_SIZE=5242880
MAX_VIDEO_UPLOAD_SIZE=52428800

# Cache / views
CACHE_TTL_SECONDS=300
VIEW_COUNT_FLUSH_EVERY=5
ENABLE_PERF_MIDDLEWARE=True

# Local demo passwords
SEED_ADMIN_PASSWORD=admin1234

# JWT
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# Optional — leave empty for local demo
# REDIS_URL=redis://127.0.0.1:6379/1
# MEILI_URL=http://127.0.0.1:7700
# MEILI_MASTER_KEY=
# MEILI_NEWS_INDEX=news

# Optional SPA CORS
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# CORS_ALLOW_CREDENTIALS=False

# Production-only (news_platform.settings.prod)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com
# ENABLE_API_DOCS=False
