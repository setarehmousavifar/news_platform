*.sql
*.dump

# Tests / coverage
.cache/
.pytest_cache/
.hypothesis/
.nox/
.coverage
htmlcov/
junit*.xml
coverage.xml
*.cover

# Node (not used, ignore if present)
node_modules/
npm-debug.log
yarn-error.log
