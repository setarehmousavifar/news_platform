# Python
*.pyc
__pycache__/
*.pyo
*.pyd
*.pdb
*.egg
*.egg-info/
dist/
build/
pip-log.txt
pip-delete-this-directory.txt

# Django / secrets
*.log
*.pot
*.sqlite3
db.sqlite3
db.sqlite3-journal
local_settings.py
.env

# Collected static (keep source `static/` tracked)
staticfiles/

# Uploaded media (keep folder via media/.gitkeep)
media/*
!media/.gitkeep

# Virtual environments (never ship these)
venv/
.venv/
.env/
.wheels/
news_platform/Lib/
news_platform/Scripts/
news_platform/pyvenv.cfg
news_platform/Include/

# Logs
logs/*.log
!logs/.gitkeep

# Docker overrides
docker-compose.override.yml
*.pid

# System / IDE
Thumbs.db
Desktop.ini
.DS_Store
.vscode/
.idea/
*.iml
*.swp
*.swo
*.tmp
*.temp
*.bak
*.old
*.orig

